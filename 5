/* Universal empty-state primitive. */
.vanta-ui-root .vanta-empty-state {
    -fx-background-color: -vantasurfaceraised;
    -fx-border-color: -vantaborder;
    -fx-border-width: 1px;
    -fx-background-radius: 16px;
    -fx-border-radius: 16px;
}

.vanta-ui-root .vanta-empty-state-icon {
    -fx-font-size: 30px;
    -fx-font-weight: 700;
    -fx-text-fill: -vantaaccent;
}

.vanta-ui-root .vanta-empty-state-eyebrow {
    -fx-padding: 0 0 2px 0;
}

.vanta-ui-root .vanta-empty-state-title {
    -fx-font-size: 15px;
    -fx-font-weight: 700;
    -fx-text-fill: -vantatext;
}

.vanta-ui-root .vanta-empty-state-description {
    -fx-font-size: 12px;
    -fx-text-fill: -vantamuted;
    -fx-text-alignment: center;
}
