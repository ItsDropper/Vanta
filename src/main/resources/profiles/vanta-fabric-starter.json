{
  "schemaVersion": 1,
  "profileId": "vanta-fabric-starter",
  "profileVersion": "1.0.0",
  "minecraftVersions": [
    "1.21.11"
  ],
  "loader": "fabric",
  "bundles": [
    {
      "id": "essentials",
      "name": "Fabric Essentials",
      "description": "The official Fabric API, resolved to the newest compatible release for this Minecraft version.",
      "required": true,
      "defaultEnabled": true,
      "mods": [
        {
          "projectId": "fabric-api",
          "versionId": null,
          "required": true,
          "defaultEnabled": true
        }
      ]
    },
    {
      "id": "vanta-client",
      "name": "Vanta Client",
      "description": "Install the latest Vanta Client build for this computer. Vanta automatically selects the correct operating-system and CPU build.",
      "required": false,
      "defaultEnabled": false,
      "mods": [
        {
          "projectId": "vanta-client",
          "versionId": null,
          "required": true,
          "defaultEnabled": true,
          "githubRelease": {
            "repository": "ItsDropper/Vanta-Client",
            "assetPrefix": "dropperutils-"
          }
        }
      ]
    }
  ]
}
